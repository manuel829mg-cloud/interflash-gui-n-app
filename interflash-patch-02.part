mand?->warn('ADMIN_EMAIL / ADMIN_PASSWORD are empty. Super Admin was not created.');
+            return;
+        }
+
+        $superAdmin = User::updateOrCreate(
+            ['email' => $email],
+            [
+                'name' => $name,
+                'password' => Hash::make($password),
+            ]
+        );
         $superAdmin->assignRole('Super Admin');
     }
 }
