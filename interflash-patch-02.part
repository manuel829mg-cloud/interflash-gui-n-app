@@ -0,0 +1,9 @@
+[build]
+builder = "NIXPACKS"
+buildCommand = "composer install --no-dev --optimize-autoloader && npm ci && npm run build"
+
+[deploy]
+startCommand = "php artisan migrate --force && php artisan storage:link || true; php artisan serve --host=0.0.0.0 --port=$PORT"
+healthcheckPath = "/"
+restartPolicyType = "ON_FAILURE"
+restartPolicyMaxRetries = 5
